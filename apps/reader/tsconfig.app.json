{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.obsidian"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "jsx": "react-jsx",
    "isolatedDeclarations": false,
    "plugins": [
      {
        "name": "@effect/language-service",
        "effectFn": ["inferred-span"],
        "allowedUnstableApis": ["effect/FileSystem"]
      }
    ],
    "types": []
  },
  "include": [
    "./src/**/*.ts",
    "../../packages/obsidian-kit/src/typings/*.d.ts",
    "../../packages/plugin-services/src/typings/*.d.ts",
    "../../packages/plugin-kernel/src/typings/*.d.ts"
  ],
  "exclude": ["./node_modules", "./dist", "./dist-dev", "./src/**/*.test.ts"]
}
