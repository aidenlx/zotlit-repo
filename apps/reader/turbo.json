{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs",
        "@zotlit/reader-messages#generate:language-packs",
        "@zotlit/pdf-reader#generate"
      ],
      "env": ["$TURBO_EXTENDS$", "MIN_APP_VERSION"]
    },
    "build:dev": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs",
        "@zotlit/reader-messages#generate:language-packs",
        "@zotlit/pdf-reader#generate"
      ],
      "cache": false,
      "env": ["MIN_APP_VERSION", "ZT_VAULT_CASE"]
    },
    "dev": {
      "env": ["MIN_APP_VERSION", "ZT_VAULT_CASE"]
    },
    "typecheck": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs",
        "@zotlit/reader-messages#generate:language-packs",
        "@zotlit/pdf-reader#generate"
      ]
    },
    "typecheck:test": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs",
        "@zotlit/reader-messages#generate:language-packs",
        "@zotlit/pdf-reader#generate"
      ]
    },
    "test": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs",
        "@zotlit/reader-messages#generate:language-packs",
        "@zotlit/pdf-reader#generate"
      ]
    }
  }
}
