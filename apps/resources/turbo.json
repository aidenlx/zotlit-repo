{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["$TURBO_EXTENDS$", "MIN_APP_VERSION"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/licences/**"]
    },
    "build:dev": {
      "cache": false,
      "env": ["MIN_APP_VERSION", "ZT_VAULT_CASE"]
    }
  }
}
