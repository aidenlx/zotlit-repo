{
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.node26"],
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedDeclarations": false,
    "lib": [
      "es2025",
      "esnext.disposable",
      "esnext.array",
      "esnext.collection",
      "esnext.temporal",
      "esnext.intl",
      "esnext.date",
      "esnext.error",
      "dom"
    ],
    "types": ["node"]
  },
  "include": ["./scripts/**/*.ts", "./src/**/*.ts", "./vitest.config.ts"],
  "exclude": ["./node_modules"]
}
