{
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.obsidian"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "jsx": "react-jsx",
    "isolatedDeclarations": false,
    "plugins": [
      {
        "name": "@effect/language-service",
        "effectFn": ["inferred-span"],
        "allowedUnstableApis": [
          "@effect/platform-browser",
          "@effect/platform-node",
          "@effect/vitest",
          "effect/FileSystem",
          "effect/http",
          "effect/PlatformError",
          "effect/rpc",
          "effect/testing",
          "effect/workers"
        ]
      }
    ],
    "types": ["node-24"],
    "paths": {
      "@/*": ["./src/*"],
      "@brand/*": ["../../assets/logo/*"]
    }
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "../../packages/obsidian-kit/src/typings/*.d.ts"
  ],
  "exclude": [
    "./src/__fixtures__/mobile-host/host.check.ts",
    "./node_modules",
    "./dist",
    "./dist-dev",
    "./src/**/*.test.ts",
    "./src/**/*.test.tsx"
  ]
}
