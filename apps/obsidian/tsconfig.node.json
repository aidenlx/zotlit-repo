{
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.node26"],
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedDeclarations": false,
    "plugins": [
      {
        "name": "@effect/language-service",
        "effectFn": ["inferred-span"],
        "allowedUnstableApis": ["effect/rpc", "effect/workers"]
      }
    ],
    "types": ["node"]
  },
  "include": [
    "./scripts/**/*.js",
    "./scripts/**/*.ts",
    "vite.config.ts",
    "vite.mobile.config.ts"
  ],
  "exclude": ["./node_modules", "./src/**/*"]
}
