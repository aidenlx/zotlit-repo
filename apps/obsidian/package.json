{
  "name": "@zotlit/obsidian",
  "version": "2.2.4",
  "private": true,
  "description": "Your Zotero research desk. Browse and query your library, read and annotate PDFs, take literature notes, cite as you write, and export to Word with a formatted reference list.",
  "author": "AidenLx",
  "type": "module",
  "exports": {
    "./e2e": {
      "types": "./src/e2e.ts"
    }
  },
  "scripts": {
    "build": "vite build && npm run typecheck",
    "build:dev": "vite build --mode development",
    "dev": "vite build --watch --mode development",
    "dev:vault": "npm run build:dev && ../../packages/scripts/scripts/obsidian-vault.ts open && npm run dev",
    "dev:i18n": "I18N_DEV_SERVER=true vite build --watch --mode development",
    "analyze": "ANALYZE=true vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint",
    "test": "vitest run",
    "bench": "vitest run --config vitest.bench.config.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "^1.0.0",
    "@effect/atom-react": "catalog:",
    "@effect/platform-browser": "catalog:",
    "@effect/platform-node": "catalog:",
    "@hono/node-server": "catalog:",
    "@std/async": "catalog:",
    "@std/collections": "catalog:",
    "@tanstack/react-virtual": "^3.14.26",
    "@uiw/react-codemirror": "^4.25.11",
    "@zotlit/annotations": "workspace:*",
    "@zotlit/citations": "workspace:*",
    "@zotlit/db": "workspace:*",
    "@zotlit/filter-expression": "workspace:*",
    "@zotlit/item-lookup": "workspace:*",
    "@zotlit/item-query": "workspace:*",
    "@zotlit/obsidian-desktop": "workspace:*",
    "@zotlit/obsidian-i18n": "workspace:*",
    "@zotlit/obsidian-kit": "workspace:*",
    "@zotlit/pdf-structure": "workspace:*",
    "@zotlit/plugin-kernel": "workspace:*",
    "@zotlit/plugin-messages": "workspace:*",
    "@zotlit/plugin-services": "workspace:*",
    "@zotlit/protocol": "workspace:*",
    "@zotlit/shared": "workspace:*",
    "@zotlit/templates": "workspace:*",
    "@zotlit/ui": "workspace:*",
    "@zotlit/workbench": "workspace:*",
    "@zotlit/zotero-reads": "workspace:*",
    "@zotlit/zotero-types": "workspace:*",
    "arkregex": "catalog:",
    "effect": "catalog:",
    "eta": "catalog:",
    "fflate": "catalog:",
    "hono": "catalog:",
    "monkey-around": "catalog:",
    "nanoid": "catalog:",
    "preact": "catalog:",
    "react-textarea-autosize": "^8.5.9",
    "scheduler": "catalog:",
    "semver": "^7.8.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@codemirror/commands": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/lint": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@effect/vitest": "catalog:",
    "@electron/remote": "catalog:",
    "@logtape/logtape": "catalog:",
    "@preact/preset-vite": "catalog:",
    "@tailwindcss/node": "^4.3.0",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/node-24": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/semver": "^7.7.1",
    "@types/turndown": "catalog:",
    "@zotlit/config": "workspace:*",
    "@zotlit/db-testing": "workspace:*",
    "@zotlit/scripts": "workspace:*",
    "ajv": "catalog:",
    "electron": "catalog:",
    "happy-dom": "catalog:",
    "jieba-wasm": "catalog:",
    "obsidian": "catalog:",
    "oxlint": "catalog:",
    "pandoc-wasm": "catalog:",
    "tailwindcss": "catalog:",
    "turndown": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vite-bundle-analyzer": "^1.3.8",
    "vitest": "catalog:"
  },
  "authorUrl": "https://github.com/aidenlx",
  "obsidian": {
    "id": "zotlit",
    "name": "ZotLit",
    "minAppVersion": "1.15.1",
    "minElectronVersion": "43.0.0",
    "isDesktopOnly": true,
    "fundingUrl": {
      "GitHub Sponsor": "https://github.com/sponsors/aidenlx"
    }
  }
}
