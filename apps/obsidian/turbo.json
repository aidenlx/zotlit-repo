{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs",
        "@zotlit/workbench#generate:message-types",
        "@zotlit/item-query#generate:schema"
      ],
      "env": [
        "$TURBO_EXTENDS$",
        "ANALYZE",
        "ANNOTATION_SUGGESTER_ENABLED",
        "MIN_APP_VERSION",
        "WEB_WORKBENCH_ENABLED"
      ],
      "outputs": ["$TURBO_EXTENDS$", "bundle-stats.html"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/project.inlang/settings.json",
        "$TURBO_ROOT$/messages/**",
        "$TURBO_ROOT$/assets/logo/**"
      ]
    },
    "build:dev": {
      "cache": false,
      "env": [
        "ANALYZE",
        "ANNOTATION_SUGGESTER_ENABLED",
        "DOCS_SITE_URL",
        "I18N_DEV_SERVER",
        "MIN_APP_VERSION",
        "WEB_WORKBENCH_ENABLED",
        "ZT_VAULT_CASE"
      ],
      "outputs": ["$TURBO_EXTENDS$", "bundle-stats.html"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/project.inlang/settings.json",
        "$TURBO_ROOT$/messages/**",
        "$TURBO_ROOT$/assets/logo/**"
      ]
    },
    "dev": {
      "env": [
        "ANALYZE",
        "ANNOTATION_SUGGESTER_ENABLED",
        "DOCS_SITE_URL",
        "I18N_DEV_SERVER",
        "MIN_APP_VERSION",
        "WEB_WORKBENCH_ENABLED",
        "ZT_VAULT_CASE"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs",
        "@zotlit/workbench#generate:message-types"
      ]
    },
    "typecheck:test": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs",
        "@zotlit/workbench#generate:message-types"
      ]
    },
    "typecheck:node": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs",
        "@zotlit/workbench#generate:message-types"
      ]
    },
    "test": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs"
      ],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/assets/logo/**"]
    }
  }
}
