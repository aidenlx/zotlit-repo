{
  "extends": ["@zotlit/config/tsconfig"],
  "compilerOptions": {
    "target": "es2024",
    // `es2025.regexp` covers `RegExp.escape`, which policies/regex.md requires
    // for dynamic literal text.
    "lib": [
      "es2024",
      "es2025.regexp",
      "esnext.array",
      "esnext.disposable",
      // The query function reference reads @zotlit/item-query source, which
      // types dates with `Temporal`.
      // @see src/lib/query-functions/reference.ts
      "esnext.temporal",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "isolatedDeclarations": false,
    "noUncheckedSideEffectImports": true,
    "types": ["./worker-configuration.d.ts", "vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"],
  "exclude": ["./node_modules", "./dist", "./.tanstack"]
}
