{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zotlit-docs",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "zotlit.aidenlx.site", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/zh-CN/docs",
      "/zh-CN/docs/*",
      "/zh-CN/changelog",
      "/zh-CN/changelog/*",
      "/zh-CN/blog",
      "/zh-CN/blog/*",
      "/zh-CN/learn",
      "/zh-CN/learn/*",
      "/docs",
      "/docs/*",
      "/changelog",
      "/changelog/*",
      "/blog",
      "/blog/*",
      "/learn",
      "/learn/*",
      "!/changelog/rss.xml",
    ],
  },
  "vars": {
    "DOCS_LINE": "production",
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "secrets": {
    "required": ["GITHUB_TOKEN"],
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "beta": {
      "name": "zotlit-docs-beta",
      "preview_urls": false,
      "routes": [
        { "pattern": "zotlit-beta.aidenlx.site", "custom_domain": true },
      ],
      "vars": {
        "DOCS_LINE": "beta",
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "secrets": {
        "required": ["GITHUB_TOKEN"],
      },
    },
  },
}
