{
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.zotero"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowJs": true,
    "isolatedDeclarations": false,
    // The checker reads @zotlit/db source, which types its dates with
    // Temporal. Zotero code itself has no Temporal at runtime
    // (policies/dates.md).
    "lib": [
      "es2025",
      "esnext.error",
      "esnext.array",
      "esnext.disposable",
      "esnext.temporal",
      "DOM"
    ],
    "types": ["zotero-types/entries/sandbox"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["./src/**/*.ts", "./src/types/**/*.d.ts"],
  "exclude": ["./node_modules", "./dist", "./dist-dev"]
}
