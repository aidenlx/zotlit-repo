{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The Fluent plugin derives the Companion's FTL files and
    // `src/types/fluent.ts` from the `zotero` namespace of the root catalogs.
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/project.inlang/settings.json",
        "$TURBO_ROOT$/messages/**"
      ]
    },
    "build:dev": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/project.inlang/settings.json",
        "$TURBO_ROOT$/messages/**"
      ]
    }
  }
}
