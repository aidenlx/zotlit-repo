{
  "$schema": "https://turborepo.dev/schema.json",
  "cacheMaxAge": "7d",
  "cacheMaxSize": "10GB",
  "globalDependencies": ["mise.toml"],
  "globalEnv": ["ZOTLIT_TOOLCHAIN"],
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "remoteCache": {
    "teamSlug": "aidenlxs-projects"
  },
  "globalPassThroughEnv": [
    "AI_AGENT",
    "CLAUDE_CODE",
    "CLAUDECODE",
    "CODEX_SANDBOX",
    "CODEX_THREAD_ID",
    "ZOTLIT_DESKTOP_DIR",
    "ZOTLIT_DESKTOP_SLOT",
    "ZOTLIT_DESKTOP_SLOTS",
    "ZOTLIT_DESKTOP_WAIT",
    "ZOTLIT_MEMORY_GATE",
    "ZOTLIT_MEMORY_GATE_ADMITTED"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["transit"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only",
      "env": ["DOCS_SITE_URL"]
    },
    "build:dev": {
      "dependsOn": ["transit"],
      "outputs": ["dist-dev/**"],
      "outputLogs": "errors-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "typecheck:test": {
      "dependsOn": ["transit"]
    },
    "typecheck:node": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "env": ["GITHUB_ACTIONS", "ZOTLIT_TEST_ELECTRON_PATH"]
    },
    "fixture": {
      "dependsOn": [
        "transit",
        "@zotlit/obsidian#build:dev",
        "@zotlit/reader#build:dev",
        "@zotlit/resources#build:dev",
        "@zotlit/zotero#build:dev"
      ],
      "cache": false,
      "passThroughEnv": ["ZT_HOST_VAULT", "ZOTERO_APP", "ZT_VAULT_CASE"]
    },
    "e2e": {
      "dependsOn": [
        "transit",
        "@zotlit/obsidian#build:dev",
        "@zotlit/reader#build:dev",
        "@zotlit/resources#build:dev",
        "@zotlit/zotero#build:dev"
      ],
      "cache": false
    },
    "//#lint:repo:deps": {
      "dependsOn": [
        "@zotlit/plugin-messages#generate:language-packs",
        "@zotlit/reader-messages#generate:language-packs",
        "@zotlit/item-query#generate:schema",
        "@zotlit/pdf-reader#generate",
        "@zotlit/docs#generate:messages",
        "@zotlit/docs#cf-typegen:check"
      ]
    },
    "//#lint:repo": {
      "dependsOn": ["//#lint:repo:deps"]
    },
    "//#test:eval-runtime": {
      "dependsOn": [
        "@zotlit/db#transit",
        "@zotlit/item-query#generate:schema",
        "@zotlit/item-query#transit",
        "@zotlit/scripts#transit",
        "@zotlit/zotero-types#transit"
      ],
      "inputs": ["skills/zotlit-query/**"]
    },
    "//#lint:format-versions": {
      "cache": false
    },
    "//#lint:test-gates": {},
    "//#lint:plugin-packages": {},
    "//#lint:runtime-zones": {
      "dependsOn": ["//#lint:repo:deps"]
    },
    "//#lint:record-pr": {
      "dependsOn": ["@zotlit/scripts#transit"],
      "inputs": [".github/workflows/record-pr.yml"]
    },
    "//#lint:nightly-e2e-notify": {
      "dependsOn": ["@zotlit/scripts#transit"],
      "inputs": [".github/workflows/nightly-e2e-notify.yml"]
    },
    "//#lint:messages": {},
    "//#lint:unused": {
      "dependsOn": ["//#lint:repo:deps"]
    },
    "//#review:plugin:deps": {
      "dependsOn": [
        "@zotlit/plugin-messages#generate:language-packs",
        "@zotlit/reader-messages#generate:language-packs",
        "@zotlit/pdf-reader#generate"
      ]
    },
    "//#review:plugin": {
      "dependsOn": ["//#review:plugin:deps"],
      "inputs": [
        "eslint.config.js",
        "manifest.json",
        "packages/config/src/core/repositories.ts",
        "packages/scripts/lib/plugin-packages.ts",
        "packages/scripts/lib/scanner-eslint.ts",
        "packages/scripts/lib/shell/plugins.ts",
        "packages/*/package.json",
        "apps/obsidian/src/**",
        "apps/obsidian/package.json",
        "apps/obsidian/tsconfig*.json",
        "packages/plugin-kernel/src/**",
        "packages/plugin-kernel/tsconfig*.json",
        "packages/obsidian-kit/src/**",
        "packages/obsidian-kit/tsconfig*.json",
        "packages/obsidian-desktop/src/**",
        "packages/obsidian-desktop/tsconfig*.json",
        "packages/zotero-reads/src/**",
        "packages/zotero-reads/tsconfig*.json",
        "packages/plugin-services/src/**",
        "packages/plugin-services/tsconfig*.json",
        "packages/annotations/src/**",
        "packages/annotations/tsconfig*.json",
        "packages/citations/src/**",
        "packages/citations/tsconfig*.json",
        "packages/notes/src/**",
        "packages/notes/tsconfig*.json",
        "packages/plugin-shell/src/**",
        "packages/plugin-shell/tsconfig*.json",
        "packages/template-workbench/src/**",
        "packages/template-workbench/tsconfig*.json",
        "packages/query-views/src/**",
        "packages/query-views/tsconfig*.json",
        "packages/library-view/src/**",
        "packages/library-view/tsconfig*.json"
      ]
    },
    "//#review:reader": {
      "dependsOn": ["//#review:plugin:deps"],
      "inputs": [
        "eslint.config.js",
        "packages/config/src/core/repositories.ts",
        "packages/scripts/lib/plugin-packages.ts",
        "packages/scripts/lib/scanner-eslint.ts",
        "packages/scripts/lib/shell/plugins.ts",
        "packages/*/package.json",
        "apps/reader/src/**",
        "apps/reader/package.json",
        "apps/reader/tsconfig*.json",
        "packages/obsidian-desktop/src/**",
        "packages/obsidian-desktop/tsconfig*.json",
        "packages/obsidian-kit/src/**",
        "packages/obsidian-kit/tsconfig*.json",
        "packages/pdf-reader/src/**",
        "packages/pdf-reader/tsconfig*.json",
        "packages/plugin-kernel/src/**",
        "packages/plugin-kernel/tsconfig*.json",
        "packages/plugin-services/src/**",
        "packages/plugin-services/tsconfig*.json",
        "packages/plugin-shell/src/**",
        "packages/plugin-shell/tsconfig*.json",
        "packages/reader-feature/src/**",
        "packages/reader-feature/tsconfig*.json",
        "packages/zotero-reads/src/**",
        "packages/zotero-reads/tsconfig*.json"
      ]
    },
    "//#review:manifest": {
      "inputs": [
        "eslint.config.js",
        "pnpm-lock.yaml",
        "apps/obsidian/package.json",
        "apps/reader/package.json",
        "apps/resources/package.json",
        "packages/config/src/core/repositories.ts",
        "packages/scripts/lib/obsidian-manifest.ts",
        "packages/scripts/lib/package-roots.ts",
        "packages/scripts/package.json",
        "packages/scripts/lib/shell/plugins.ts",
        "packages/scripts/scripts/check-manifest.ts"
      ]
    }
  }
}
