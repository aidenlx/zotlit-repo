{
  "$schema": "https://turborepo.dev/schema.json",
  "cacheMaxAge": "7d",
  "cacheMaxSize": "10GB",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "globalPassThroughEnv": [
    "AI_AGENT",
    "CLAUDE_CODE",
    "CLAUDECODE",
    "CODEX_SANDBOX",
    "CODEX_THREAD_ID",
    "ZOTLIT_DESKTOP_DIR",
    "ZOTLIT_DESKTOP_SLOT",
    "ZOTLIT_DESKTOP_SLOTS",
    "ZOTLIT_DESKTOP_WAIT",
    "ZOTLIT_MEMORY_GATE",
    "ZOTLIT_MEMORY_GATE_ADMITTED"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["transit"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only",
      "env": ["DOCS_SITE_URL"]
    },
    "build:dev": {
      "dependsOn": ["transit"],
      "outputs": ["dist-dev/**"],
      "outputLogs": "errors-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "typecheck:test": {
      "dependsOn": ["transit"]
    },
    "typecheck:node": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "env": ["GITHUB_ACTIONS"]
    },
    "fixture": {
      "dependsOn": [
        "transit",
        "@zotlit/obsidian#build:dev",
        "@zotlit/zotero#build:dev"
      ],
      "cache": false,
      "passThroughEnv": ["ZT_HOST_VAULT", "ZOTERO_APP", "ZT_VAULT_CASE"]
    },
    "e2e": {
      "dependsOn": [
        "transit",
        "@zotlit/obsidian#build:dev",
        "@zotlit/zotero#build:dev"
      ],
      "cache": false
    },
    "//#lint:repo:deps": {
      "dependsOn": [
        "@zotlit/plugin-messages#generate:language-packs",
        "@zotlit/workbench#generate:message-types",
        "@zotlit/item-query#generate:schema",
        "@zotlit/docs#generate:messages",
        "@zotlit/docs#cf-typegen:check"
      ]
    },
    "//#lint:repo": {
      "dependsOn": ["//#lint:repo:deps"]
    },
    "//#lint:format-versions": {
      "cache": false
    },
    "//#lint:test-gates": {},
    "//#lint:messages": {},
    "//#lint:unused": {
      "dependsOn": ["//#lint:repo:deps"]
    },
    "//#review:plugin:deps": {
      "dependsOn": [
        "@zotlit/plugin-messages#generate:language-packs",
        "@zotlit/workbench#generate:message-types"
      ]
    },
    "//#review:plugin": {
      "dependsOn": ["//#review:plugin:deps"],
      "inputs": [
        "eslint.config.js",
        "manifest.json",
        "apps/obsidian/src/**",
        "apps/obsidian/package.json",
        "apps/obsidian/tsconfig*.json",
        "packages/plugin-kernel/src/**",
        "packages/plugin-kernel/tsconfig*.json",
        "packages/obsidian-kit/src/**",
        "packages/obsidian-kit/tsconfig*.json",
        "packages/obsidian-desktop/src/**",
        "packages/obsidian-desktop/tsconfig*.json",
        "packages/zotero-reads/src/**",
        "packages/zotero-reads/tsconfig*.json",
        "packages/plugin-services/src/**",
        "packages/plugin-services/tsconfig*.json",
        "packages/annotations/src/**",
        "packages/annotations/tsconfig*.json",
        "packages/citations/src/**",
        "packages/citations/tsconfig*.json"
      ]
    },
    "//#review:manifest": {
      "inputs": [
        "eslint.config.js",
        "pnpm-lock.yaml",
        "apps/obsidian/package.json",
        "packages/scripts/lib/obsidian-manifest.ts",
        "packages/scripts/scripts/check-manifest.ts"
      ]
    }
  }
}
