{
  "name": "@zotlit/workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./completion": "./src/language/semantics.ts",
    "./document": "./src/document/index.ts",
    "./explorer": "./src/explorer/index.ts",
    "./language": "./src/language/index.ts",
    "./match": "./src/match/index.ts",
    "./render": "./src/render/index.ts",
    "./ui": "./src/ui/index.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "vitest run",
    "generate:eta": "lezer-generator src/language/eta.grammar -o src/language/eta-parser.ts --typeScript",
    "generate:message-types": "node scripts/generate-message-types.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-liquid": "6.3.2",
    "@codemirror/lint": "catalog:",
    "@lezer/common": "catalog:",
    "@lezer/highlight": "catalog:",
    "@lezer/lr": "catalog:",
    "@lezer/markdown": "catalog:",
    "@zotlit/db": "workspace:*",
    "@zotlit/filter-expression": "workspace:*",
    "@zotlit/item-query": "workspace:*",
    "@zotlit/notes": "workspace:*",
    "@zotlit/plugin-kernel": "workspace:*",
    "@zotlit/templates": "workspace:*",
    "@zotlit/ui": "workspace:*",
    "@zotlit/zotero-reads": "workspace:*",
    "@zotlit/zotero-types": "workspace:*",
    "arkregex": "catalog:",
    "diff": "catalog:",
    "effect": "catalog:",
    "jsonc-parser": "^3.3.1",
    "valibot": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@effect/atom-react": "catalog:",
    "@effect/vitest": "catalog:",
    "@lezer/generator": "1.8.0",
    "@testing-library/dom": "catalog:",
    "@testing-library/preact": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@zotlit/config": "workspace:*",
    "@zotlit/obsidian-i18n": "workspace:*",
    "ajv": "catalog:",
    "happy-dom": "catalog:",
    "oxlint": "catalog:",
    "preact": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "scheduler": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@effect/atom-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "scheduler": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/atom-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "scheduler": {
      "optional": true
    }
  }
}
