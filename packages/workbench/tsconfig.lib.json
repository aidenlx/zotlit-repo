{
  "extends": ["@zotlit/config/tsconfig"],
  "compilerOptions": {
    "target": "ES2025",
    "lib": [
      "ES2025",
      "DOM",
      "ESNext.Disposable",
      "ESNext.Error",
      "ESNext.Temporal",
      "ESNext.Date",
      "ESNext.Intl"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedDeclarations": false,
    "jsx": "react-jsx",
    "types": []
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"],
  "exclude": [
    "./node_modules",
    "./src/**/*.test.ts",
    "./src/**/*.test.tsx",
    "./src/explorer/test-records.ts",
    "./src/render/test-profiles.ts",
    "./src/ui/test-host.tsx",
    "./src/ui/test-messages.ts",
    "./src/ui/generated/test-en.json"
  ]
}
