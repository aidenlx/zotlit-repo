{
  "name": "@zotlit/plugin-services",
  "version": "0.0.0",
  "private": true,
  "description": "The platform services every ZotLit Obsidian plugin's features stand on: settings, logging, the Language Pack, the Zotero preferences and connections, the database and query clients, item search, the Literature Note index, and attachments",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint",
    "test": "vitest run",
    "bench": "vitest run --config vitest.bench.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/valibot-validator": "^0.6.1",
    "@std/ini": "jsr:0.225.2",
    "@tanstack/query-core": "catalog:",
    "@zotlit/db": "workspace:*",
    "@zotlit/item-lookup": "workspace:*",
    "@zotlit/obsidian-desktop": "workspace:*",
    "@zotlit/obsidian-i18n": "workspace:*",
    "@zotlit/obsidian-kit": "workspace:*",
    "@zotlit/plugin-kernel": "workspace:*",
    "@zotlit/plugin-messages": "workspace:*",
    "@zotlit/protocol": "workspace:*",
    "@zotlit/resource-pack": "workspace:*",
    "@zotlit/shared": "workspace:*",
    "@zotlit/templates": "workspace:*",
    "@zotlit/zotero-compat": "workspace:*",
    "@zotlit/zotero-reads": "workspace:*",
    "@zotlit/zotero-types": "workspace:*",
    "arkregex": "catalog:",
    "effect": "catalog:",
    "fflate": "catalog:",
    "hono": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@preact/preset-vite": "catalog:",
    "@types/node": "catalog:",
    "@types/node-24": "catalog:",
    "@zotlit/config": "workspace:*",
    "@zotlit/scripts": "workspace:*",
    "happy-dom": "catalog:",
    "jieba-wasm": "catalog:",
    "obsidian": "catalog:",
    "oxlint": "catalog:",
    "preact": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
