{
  "extends": ["@zotlit/config/tsconfig"],
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["ES2025", "WebWorker", "ESNext.Disposable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedDeclarations": false,
    "types": []
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./node_modules", "./src/**/*.test.ts"]
}
