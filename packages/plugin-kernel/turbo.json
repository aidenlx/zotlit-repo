{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The source reads the plugin's generated Message facade.
    "typecheck": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs"
      ]
    },
    "typecheck:test": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs"
      ]
    },
    "test": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs"
      ],
      // The brand test reads the canonical logo SVGs.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/assets/logo/**"]
    }
  }
}
