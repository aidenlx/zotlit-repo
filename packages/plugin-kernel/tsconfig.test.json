{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "types": ["node-24"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@brand/*": ["../../assets/logo/*"]
