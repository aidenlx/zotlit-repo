{
  "name": "@zotlit/pdf-structure",
  "version": "0.0.0",
  "private": true,
  "description": "Pinned port of Zotero's PDF text structure, with the Sort Index and Page Label it computes",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*",
    "#oracle/*": "./oracle/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@zotlit/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zotlit/config": "workspace:*",
    "@zotlit/scripts": "workspace:*",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "zotlit": {
    "layer": "worker"
  }
}
