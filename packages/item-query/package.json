{
  "name": "@zotlit/item-query",
  "version": "0.0.0",
  "private": true,
  "description": "Field-oriented queries over top-level Zotero Items",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./query.schema.json": "./generated/query.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate:schema": "node scripts/write-schema.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@logtape/logtape": "catalog:",
    "@zotlit/db": "workspace:*",
    "@zotlit/filter-expression": "workspace:*",
    "@zotlit/shared": "workspace:*",
    "@zotlit/zotero-types": "workspace:*",
    "arkregex": "catalog:",
    "effect": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zotlit/config": "workspace:*",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
