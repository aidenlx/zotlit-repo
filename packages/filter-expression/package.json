{
  "name": "@zotlit/filter-expression",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "vitest run",
    "generate:parser": "lezer-generator src/filter-expression.grammar --typeScript --names -o src/generated/parser.ts && oxfmt src/generated"
  },
  "dependencies": {
    "@lezer/common": "catalog:",
    "@lezer/lr": "catalog:"
  },
  "devDependencies": {
    "@lezer/generator": "1.8.0",
    "@types/node": "catalog:",
    "@zotlit/config": "workspace:*",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "zotlit": {
    "layer": "worker"
  }
}
