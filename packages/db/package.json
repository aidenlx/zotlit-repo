{
  "name": "@zotlit/db",
  "version": "0.0.0",
  "private": true,
  "description": "Zotero SQLite database layer for reading Zotero libraries",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*",
    "#drizzle/*": "./drizzle/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client/node": "./src/desktop/node-client.ts",
    "./client/wasm": "./src/client/wasm.ts",
    "./contract/ir": "./src/contract/ir.ts",
    "./item-fixture": "./src/item-fixture.ts",
    "./item-query": "./src/item-query/index.ts",
    "./path": "./src/lib/zt-path.ts",
    "./replica": "./src/replica/index.ts",
    "./replica/parity-pair": "./src/replica/__fixtures__/parity.ts",
    "./replica/staging-invariants": "./src/replica/__fixtures__/staging-invariants.ts",
    "./replica/web-api-public-group.json": "./src/replica/__fixtures__/web-api-public-group.json",
    "./template-data": "./src/template-data/index.ts",
    "./contract/ir.json": "./src/contract/generated/ir.json",
    "./contract/ir.runtime.json": "./src/contract/generated/ir.runtime.json",
    "./contract/note.schema.json": "./src/contract/generated/note.schema.json",
    "./contract/annotation.schema.json": "./src/contract/generated/annotation.schema.json",
    "./contract/filename.schema.json": "./src/contract/generated/filename.schema.json",
    "./contract/citation.schema.json": "./src/contract/generated/citation.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "db:pull": "drizzle-kit pull",
    "generate:contract": "node scripts/generate-contract.ts && oxfmt src/contract/generated",
    "generate:replica-layout": "node scripts/generate-replica-layout.ts && oxfmt src/replica/layout.generated.ts",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@std/collections": "catalog:",
    "@zotlit/drizzle-sqlite-wasm": "workspace:*",
    "@zotlit/protocol": "workspace:*",
    "@zotlit/shared": "workspace:*",
    "@zotlit/zotero-compat": "workspace:*",
    "@zotlit/zotero-types": "workspace:*",
    "arkregex": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "catalog:",
    "@types/node": "catalog:",
    "@types/node-24": "catalog:",
    "@zotlit/config": "workspace:*",
    "@zotlit/db-testing": "workspace:*",
    "ajv": "catalog:",
    "drizzle-kit": "catalog:",
    "oxlint": "catalog:",
    "ts-morph": "^28.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "zotlit": {
    "layer": "worker"
  }
}
