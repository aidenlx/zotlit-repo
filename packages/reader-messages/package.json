{
  "name": "@zotlit/reader-messages",
  "version": "0.0.0",
  "private": true,
  "description": "The ZotLit Reader's typed Message facade and its Language Packs, generated from the Reader's subset of messages/*.json",
  "type": "module",
  "exports": {
    "./language-pack-options": "./scripts/language-pack-options.ts",
    "./vitest-setup": "./scripts/vitest-setup.ts",
    "./*": "./generated/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate:language-packs": "node scripts/generate-language-packs.ts",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@zotlit/obsidian-i18n": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zotlit/config": "workspace:*",
    "@zotlit/plugin-messages": "workspace:*",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "zotlit": {
    "layer": "host-free"
  }
}
