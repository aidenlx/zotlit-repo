{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The suite reads the plugin's generated Message facade, so the type
    // check needs it first.
    "typecheck": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs",
        "@zotlit/reader-messages#generate:language-packs",
        "@zotlit/pdf-reader#generate"
      ]
    },
    // The ZotLit Query CLI cases read the generated Query Schema file, and the
    // reader probe plugin bundles the reader's generated assets.
    "e2e": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/item-query#generate:schema",
        "@zotlit/pdf-reader#generate"
      ],
      "env": ["ANNOTATION_SUGGESTER_ENABLED"],
      "passThroughEnv": ["ZOTLIT_E2E_RESULTS", "ZOTLIT_E2E_REQUIRED"]
    }
  }
}
