{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs",
        "@zotlit/reader-messages#generate:language-packs",
        "@zotlit/pdf-reader#generate"
      ]
    },
    "e2e": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/item-query#generate:schema",
        "@zotlit/pdf-reader#generate"
      ],
      "env": ["ANNOTATION_SUGGESTER_ENABLED"],
      "passThroughEnv": ["ZOTLIT_E2E_RESULTS", "ZOTLIT_E2E_REQUIRED"]
    }
  }
}
