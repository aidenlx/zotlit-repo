{
  "name": "@zotlit/obsidian-i18n",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "obsidian-i18n": "./bin.mjs"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./compiler": "./src/compiler.ts",
    "./vite": "./src/vite.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@inlang/plugin-m-function-matcher": "2.2.9",
    "@inlang/plugin-message-format": "catalog:",
    "@inlang/sdk": "2.9.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zotlit/config": "workspace:*",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
