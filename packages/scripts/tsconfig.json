{
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.node26"],
  "compilerOptions": {
    "isolatedDeclarations": false,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": ["@effect/vitest"]
      }
    ]
  },
  "include": ["./lib/**/*.ts", "./scripts/**/*.ts"],
  "exclude": ["./node_modules"]
}
