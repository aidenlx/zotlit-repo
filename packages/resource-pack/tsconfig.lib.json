{
  "extends": ["@zotlit/config/tsconfig"],
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedDeclarations": false,
    "types": []
  },
  "include": ["./src/**/*.ts"],
  "exclude": [
    "./node_modules",
    "./src/**/*.test.ts",
    "./src/**/*.browser-test.ts"
  ]
}
