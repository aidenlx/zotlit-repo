{
  "name": "@zotlit/templates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#defaults/*": "./defaults/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./facade": "./src/facade.ts",
    "./frontmatter": "./src/frontmatter.ts",
    "./frontmatter-merge": "./src/frontmatter-merge.ts",
    "./liquid": "./src/liquid.ts",
    "./literature-note-pack": "./src/literature-note-pack.ts",
    "./obsidian": "./src/obsidian.ts",
    "./pandoc-citation": "./src/pandoc-citation.ts",
    "./defaults/*.eta": "./defaults/*.eta",
    "./defaults/*.liquid": "./defaults/*.liquid",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@zotlit/filter-expression": "workspace:*",
    "@zotlit/shared": "workspace:*",
    "arkregex": "catalog:",
    "eta": "catalog:",
    "json-e": "^4.8.4",
    "liquidjs": "^10.27.2",
    "valibot": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zotlit/config": "workspace:*",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
