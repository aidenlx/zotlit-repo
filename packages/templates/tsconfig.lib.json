{
  "extends": ["@zotlit/config/tsconfig"],
  "compilerOptions": {
    "target": "ES2025",
    "lib": [
      "ES2025",
      "ESNext.Disposable",
      "ESNext.Error",
      "ESNext.Temporal",
      "ESNext.Date",
      "ESNext.Intl"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedDeclarations": false,
    "types": []
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./node_modules", "./src/**/*.test.ts"]
}
