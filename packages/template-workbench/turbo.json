{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate:eta": {
      "inputs": [
        "src/core/language/eta.grammar",
        "$TURBO_ROOT$/oxfmt.config.ts"
      ],
      "outputs": [
        "src/core/language/eta-parser.ts",
        "src/core/language/eta-parser.terms.ts"
      ],
      "outputLogs": "errors-only"
    },
    "typecheck": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs"
      ]
    },
    "typecheck:test": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs"
      ]
    },
    "test": {
      "tags": ["ci-shard-2"],
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@zotlit/plugin-messages#generate:language-packs"
      ]
    }
  }
}
