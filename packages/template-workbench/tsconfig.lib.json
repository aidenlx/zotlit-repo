{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.obsidian"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "isolatedDeclarations": false,
    "plugins": [
      {
        "name": "@effect/language-service",
        "effectFn": ["inferred-span"],
        "allowedUnstableApis": [
          // The Workbench's atom model (its atoms, scheduler and React hooks)
          // is built on the Effect Atom APIs.
          "@effect/atom-react",
          "@effect/platform-browser",
          "@effect/platform-node",
          "@effect/vitest",
          "effect/FileSystem",
          "effect/http",
          "effect/PlatformError",
          "effect/reactivity",
          "effect/rpc",
          "effect/testing",
          "effect/workers"
        ]
      }
    ],
    // The desktop layer reads Node; lint keeps Node out of the other layers.
    "types": ["node-24"]
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "../obsidian-kit/src/typings/*.d.ts",
    // The build constants the platform services read.
    "../plugin-services/src/typings/*.d.ts",
    // The built-in templates the notes read, as text.
    "../notes/src/typings/*.d.ts",
    // The build constants the citations read.
    "../citations/src/typings/build-env.d.ts",
    // The build constants the kernel reads.
    "../plugin-kernel/src/typings/*.d.ts",
    // The reader slice of the settings, which the annotation feature's Open
    // Targets read and which only a host program otherwise imports.
    "../annotations/src/obsidian/pdf-annotation-editor/settings.ts",
    // The Zotero preferences' view service, which the views read and which
    // only a host program otherwise imports.
    "../plugin-services/src/obsidian/zotero-pref/atoms.ts",
    // The citation slice, which the citations read and a host composes.
    "../citations/src/core/citation-index/settings.ts"
  ],
  "exclude": [
    "./node_modules",
    "./src/**/*.test.ts",
    "./src/**/*.test.tsx",
    "./src/**/*.browser-test.ts",
    "./src/**/__fixtures__/**",
    "./src/**/__mocks__/**",
    // The test support of the Workbench core.
    "./src/core/data-tree/test-records.ts",
    "./src/core/render/test-profiles.ts",
    "./src/obsidian/workbench-ui/test-host.tsx"
  ]
}
