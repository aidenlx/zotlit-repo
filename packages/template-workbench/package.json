{
  "name": "@zotlit/template-workbench",
  "version": "0.0.0",
  "private": true,
  "description": "The Template Workbench in Obsidian: the Template Workbench View, the Template Data Explorer, and the Template Workbench CLI",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint",
    "test": "vitest run",
    "generate:eta": "lezer-generator src/core/language/eta.grammar -o src/core/language/eta-parser.ts --typeScript",
    "generate:message-types": "node scripts/generate-message-types.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-liquid": "6.3.2",
    "@codemirror/language": "catalog:",
    "@codemirror/lint": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@effect/atom-react": "catalog:",
    "@lezer/common": "catalog:",
    "@lezer/highlight": "catalog:",
    "@lezer/lr": "catalog:",
    "@lezer/markdown": "catalog:",
    "@zotlit/annotations": "workspace:*",
    "@zotlit/citations": "workspace:*",
    "@zotlit/db": "workspace:*",
    "@zotlit/filter-expression": "workspace:*",
    "@zotlit/item-query": "workspace:*",
    "@zotlit/notes": "workspace:*",
    "@zotlit/obsidian-desktop": "workspace:*",
    "@zotlit/obsidian-kit": "workspace:*",
    "@zotlit/plugin-kernel": "workspace:*",
    "@zotlit/plugin-messages": "workspace:*",
    "@zotlit/plugin-services": "workspace:*",
    "@zotlit/plugin-shell": "workspace:*",
    "@zotlit/protocol": "workspace:*",
    "@zotlit/templates": "workspace:*",
    "@zotlit/ui": "workspace:*",
    "@zotlit/zotero-reads": "workspace:*",
    "@zotlit/zotero-types": "workspace:*",
    "arkregex": "catalog:",
    "diff": "catalog:",
    "effect": "catalog:",
    "jsonc-parser": "^3.3.1",
    "preact": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@lezer/generator": "1.8.0",
    "@preact/preset-vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/preact": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/node-24": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@zotlit/config": "workspace:*",
    "@zotlit/db-testing": "workspace:*",
    "@zotlit/obsidian-i18n": "workspace:*",
    "@zotlit/scripts": "workspace:*",
    "ajv": "catalog:",
    "happy-dom": "catalog:",
    "obsidian": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
