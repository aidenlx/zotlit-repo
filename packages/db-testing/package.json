{
  "name": "@zotlit/db-testing",
  "version": "0.0.0",
  "private": true,
  "description": "Zotero SQLite fixtures for the tests of @zotlit/db and its consumers, and the driver conformance suite",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/fixtures.ts",
    "./conformance": "./src/conformance.ts",
    "./scenario": "./src/scenario/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "lint": "oxlint"
  },
  "dependencies": {
    "@zotlit/zotero-types": "workspace:*",
    "drizzle-orm": "catalog:",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zotlit/config": "workspace:*",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
