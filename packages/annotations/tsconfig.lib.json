{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.obsidian"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "isolatedDeclarations": false,
    "plugins": [
      {
        "name": "@effect/language-service",
        "effectFn": ["inferred-span"],
        "allowedUnstableApis": [
          "@effect/atom-react",
          "@effect/platform-browser",
          "@effect/platform-node",
          "@effect/vitest",
          "effect/FileSystem",
          "effect/http",
          "effect/PlatformError",
          "effect/reactivity",
          "effect/rpc",
          "effect/testing",
          "effect/workers"
        ]
      }
    ],
    "types": ["node-24"]
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "../obsidian-kit/src/typings/*.d.ts",
    "../plugin-services/src/typings/*.d.ts"
  ],
  "exclude": [
    "./node_modules",
    "./src/**/*.test.ts",
    "./src/**/*.test.tsx",
    "./src/**/*.browser-test.ts",
    "./src/**/__fixtures__/**",
    "./src/**/__mocks__/**"
  ]
}
