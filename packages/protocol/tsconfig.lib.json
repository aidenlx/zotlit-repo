{
  "extends": ["@zotlit/config/tsconfig"],
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["ES2025", "DOM", "ESNext.Temporal"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedDeclarations": false,
    "types": ["node"]
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./node_modules", "./src/**/*.test.ts"]
}
