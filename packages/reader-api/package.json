{
  "name": "@zotlit/reader-api",
  "version": "0.0.0",
  "private": true,
  "description": "The interop contract between ZotLit Reader and the plugins that extend its PDF view",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zotlit/config": "workspace:*",
    "@zotlit/obsidian-kit": "workspace:*",
    "obsidian": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "obsidian": ">=1.14.4"
  },
  "zotlit": {
    "layer": "obsidian"
  }
}
