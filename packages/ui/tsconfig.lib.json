{
  "extends": ["@zotlit/config/tsconfig"],
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["ES2025", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedDeclarations": false,
    "jsx": "react-jsx",
    "types": []
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"],
  "exclude": ["./node_modules", "./src/**/*.test.ts", "./src/**/*.test.tsx"]
}
