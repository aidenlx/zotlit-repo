{
  "extends": ["@zotlit/config/tsconfig"],
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["ES2025", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "declaration": true,
    "declarationMap": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "isolatedDeclarations": false,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": ["@effect/atom-react", "effect/reactivity"]
      }
    ],
    "types": []
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"],
  "exclude": [
    "./node_modules",
    "./dist/**/*",
    "./src/**/*.test.ts",
    "./src/**/*.browser-test.ts"
  ]
}
