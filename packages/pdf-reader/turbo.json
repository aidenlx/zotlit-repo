{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "inputs": [
        "build/embed-assets.ts",
        "build/gen-strings.ts",
        "build/gen-pdfjs-build.ts",
        "build/build-css.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.css",
        "!src/generated/**",
        "$TURBO_ROOT$/packages/scripts/lib/package-roots.ts",
        "$TURBO_ROOT$/packages/pdfjs/provenance.json",
        "$TURBO_ROOT$/packages/pdfjs/dist/pdf.worker.mjs",
        "$TURBO_ROOT$/packages/pdfjs/dist/wasm/*.wasm",
        "$TURBO_ROOT$/packages/pdfjs/dist/pdf_viewer.css",
        "$TURBO_ROOT$/packages/pdfjs/dist/images/*.svg",
        "$TURBO_ROOT$/messages/en.json"
      ],
      "outputs": ["src/generated/**"],
      "outputLogs": "errors-only"
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "generate"]
    },
    "typecheck:test": {
      "dependsOn": ["$TURBO_EXTENDS$", "generate"]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "generate"]
    }
  }
}
